<launch>
    <!-- 1. 启动 Gazebo 空世界 -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="true"/>
    </include>

    <!-- 2. 加载机器人模型到参数服务器 -->
    <!-- 注意：这里的 hero.urdf.xacro 必须是你刚才改过（换了 gazebo_ros_control 插件）的文件 -->
    <param name="robot_description" command="$(find xacro)/xacro $(find rm_description_for_task)/urdf/hero/hero.urdf.xacro" />

    <!-- 3. 在 Gazebo 中生成机器人 -->
    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" args="-param robot_description -urdf -model hero_robot" />

    <!-- 4. 加载你的 PID 参数和关节配置 -->
    <rosparam file="$(find hero_chassis_controller)/config/pid_params.yaml" command="load"/>

    <!-- 5. 启动 controller_manager (手动启动，防止插件失效) -->
    <node name="controller_manager" pkg="controller_manager" type="controller_manager" respawn="false" output="screen">
        <!-- 告诉 manager 你的控制器叫什么名字 -->
        <param name="hero_chassis_controller/type" value="hero_chassis_controller/HeroChassisController" />
        <!-- 把 yaml 里的关节参数喂给它 -->
        <rosparam command="load" file="$(find hero_chassis_controller)/config/pid_params.yaml" />
    </node>

    <!-- 6. 使用 spawner 加载并启动你的控制器 -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" args="hero_chassis_controller" />
</launch>